                  "blocks": {
                    "mm_details_liquid": {
                      "type": "custom-liquid",
                      "settings": {
                        "custom_liquid": "{%- assign mm = product.metafields.mansmade -%}\n<dl class=\"mm-specs\">\n{%- if mm.dimensions.value != blank -%}<dt>Dimensions</dt><dd>{{ mm.dimensions.value | escape }}</dd>{%- endif -%}\n{%- if mm.material.value != blank -%}<dt>Material</dt><dd>{{ mm.material.value | escape }}</dd>{%- endif -%}\n{%- if mm.finish.value != blank -%}<dt>Finish</dt><dd>{{ mm.finish.value | escape }}</dd>{%- endif -%}\n{%- if mm.care.value != blank -%}<dt>Care</dt><dd>{{ mm.care.value | escape | newline_to_br }}</dd>{%- endif -%}\n</dl>\n<style>\n.mm-specs{display:grid;grid-template-columns:max-content 1fr;gap:.6rem 1.5rem;margin:0 0 1rem}\n.mm-specs dt{font-family:var(--font-subheading--family);font-size:.72rem;letter-spacing:.1em;text-transform:uppercase;color:#E0B68D;padding-top:.2em}\n.mm-specs dd{margin:0}\n.mm-ship p{margin:0 0 .7rem}\n.mm-ship a{color:#E0B68D;text-decoration:underline;text-underline-offset:3px}\n</style>"
                      },
                      "blocks": {}
                    }
                  },
                  "block_order": [
                    "mm_details_liquid"
                  ]
                },
                "mm_row_shipping": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "Shipping and returns",
                    "open_by_default": false,
                    "icon": "none",
                    "width": 20
                  },
                  "blocks": {
                    "mm_shipping_liquid": {
                      "type": "custom-liquid",
                      "settings": {
                        "custom_liquid": "{%- assign pt = product.metafields.mansmade.processing_time.value -%}\n<div class=\"mm-ship\">\n{%- if pt != blank -%}{%- assign pt_last = pt | slice: -1 -%}<p>{{ pt | escape }}{% if pt_last != '.' %}.{% endif %}</p>{%- endif -%}\n<p>Ships by UPS with tracking to street addresses in the United States. The exact shipping cost is shown at checkout.</p>\n<p>Free local pickup in Moore, Oklahoma, and free local delivery within 10 miles of Moore.</p>\n<p>Ready-to-ship pieces can be returned within 30 days. Custom and made-to-order pieces are final sale unless they have a defect.</p>\n<p><a href=\"{{ shop.shipping_policy.url }}\">Shipping policy</a> &nbsp;&middot;&nbsp; <a href=\"{{ shop.refund_policy.url }}\">Return policy</a></p>\n</div>"
                      },
                      "blocks": {}
